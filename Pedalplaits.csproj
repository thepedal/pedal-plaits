<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Pedal Plaits.NET</AssemblyName>
    <RootNamespace>PedalPlaits</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>

    <!-- Mandatory deployment hygiene (Build §1.2, §4) -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NoWarn>MSB3277</NoWarn>

    <!-- Output goes alongside ReBuzz's gear folder -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BuzzGUI.Interfaces">
      <HintPath>C:\Program Files\ReBuzz\BuzzGUI.Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Plaits bank_3 (Braids-derived) wavetable data, embedded into the
       DLL so deployment stays single-file. Loaded at engine init by
       Engines/PlaitsWavetables.cs. MIT-licensed alongside the rest of
       Plaits' source (pichenettes/eurorack). -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\waves.bin" />
  </ItemGroup>

  <!-- Preset bundle, deployed alongside the DLL after build. Declared as
       an ItemGroup item rather than an inline SourceFiles literal so the
       space in the filename round-trips cleanly through MSBuild — literal
       attribute paths with embedded spaces can produce silent Copy failures
       on some MSBuild configurations. -->
  <ItemGroup>
    <PresetBundle Include="Pedal Plaits_Presets.prs.xml" />
  </ItemGroup>

  <!-- Deploy to ReBuzz after every build. Generators live in Gear\Generators.
       ContinueOnError swallows the (expected) lock when ReBuzz is running with
       the DLL loaded — close ReBuzz and rebuild to refresh the deployed DLL
       and preset bundle. The Message lines surface in normal-verbosity build
       output so a failed deploy is visibly noted rather than entirely silent. -->
  <Target Name="DeployToReBuzz" AfterTargets="Build">
    <Message Text="Deploying $(TargetFileName) → C:\Program Files\ReBuzz\Gear\Generators\"
             Importance="high" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="C:\Program Files\ReBuzz\Gear\Generators\"
          ContinueOnError="true" />
    <Message Text="Deploying @(PresetBundle) → C:\Program Files\ReBuzz\Gear\Generators\"
             Importance="high" />
    <Copy SourceFiles="@(PresetBundle)"
          DestinationFolder="C:\Program Files\ReBuzz\Gear\Generators\"
          ContinueOnError="true" />
  </Target>

</Project>
