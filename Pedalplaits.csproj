<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Pedal Plaits.NET</AssemblyName>
    <RootNamespace>PedalPlaits</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>

    <!-- Mandatory deployment hygiene (Build §1.2, §4) -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NoWarn>MSB3277</NoWarn>

    <!-- Output goes alongside ReBuzz's gear folder -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BuzzGUI.Interfaces">
      <HintPath>C:\Program Files\ReBuzz\BuzzGUI.Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- MenuItemVM + SimpleCommand for the right-click About window
         (AboutWindow §1.1). -->
    <Reference Include="BuzzGUI.Common">
      <HintPath>C:\Program Files\ReBuzz\BuzzGUI.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Plaits bank_3 (Braids-derived) wavetable data, embedded into the
       DLL so deployment stays single-file. Loaded at engine init by
       Engines/PlaitsWavetables.cs. MIT-licensed alongside the rest of
       Plaits' source (pichenettes/eurorack). -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\waves.bin" />
  </ItemGroup>

  <!-- Deploy to ReBuzz after every build. Generators live in Gear\Generators.
       ContinueOnError swallows the (expected) lock when ReBuzz is running with
       the DLL loaded — close ReBuzz and rebuild to refresh it.

       The preset bundle MUST be named exactly "Pedal Plaits.prs.xml" (machine
       name + .prs.xml = the Build §3.1 auto-load form; it was previously on the
       legacy "_Presets" name and so did not auto-load). The Copy is guarded on
       Exists() with an explicit Warning per Build §3.5.1: a misnamed or missing
       bundle would otherwise emit MSB3030, which ContinueOnError silently
       downgrades to a warning — green build, no presets deployed. -->
  <Target Name="DeployToReBuzz" AfterTargets="Build">
    <PropertyGroup>
      <_PresetPath>$(MSBuildProjectDirectory)\Pedal Plaits.prs.xml</_PresetPath>
    </PropertyGroup>
    <ItemGroup>
      <_AnyPreset Include="$(MSBuildProjectDirectory)\*.prs.xml" />
    </ItemGroup>

    <Message Text="Deploying $(TargetFileName) -> C:\Program Files\ReBuzz\Gear\Generators\"
             Importance="high" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="C:\Program Files\ReBuzz\Gear\Generators\"
          ContinueOnError="true" />

    <Message Condition="Exists('$(_PresetPath)')"
             Text="Deploying preset bundle -> C:\Program Files\ReBuzz\Gear\Generators\"
             Importance="high" />
    <Copy Condition="Exists('$(_PresetPath)')"
          SourceFiles="$(_PresetPath)"
          DestinationFolder="C:\Program Files\ReBuzz\Gear\Generators\"
          ContinueOnError="true" />
    <Warning Condition="!Exists('$(_PresetPath)')"
             Text="Preset bundle NOT deployed: '$(_PresetPath)' not found. Found instead: @(_AnyPreset). Per Build 3.1 it must be named 'Pedal Plaits.prs.xml' - rename it, or presets won't appear in ReBuzz." />
  </Target>

</Project>
